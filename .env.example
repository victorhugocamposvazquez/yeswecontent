# yeswecontent: variables de entorno
# Copia este archivo a .env.local y rellena lo que necesites.
# Sin las variables de Supabase la app arranca en MODO DEMO con datos de ejemplo.

# URL pública de la app (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: webhooks, crons y panel de administración. No la expongas nunca.
SUPABASE_SERVICE_ROLE_KEY=

# Modelos de IA (redacción, estrategia y seguimiento de visibilidad)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Stripe (suscripciones). Usa claves sk_test_ en desarrollo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (emails transaccionales). Sin clave los emails se registran en consola.
RESEND_API_KEY=
# Opcional: remitente verificado en Resend
# EMAIL_FROM="yeswecontent <hola@tudominio.com>"

# Protege /api/cron/*. Vercel lo envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Google OAuth (Search Console y GA4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
