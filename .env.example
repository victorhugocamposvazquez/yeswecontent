# yeswecontent: variables de entorno
# Copia este archivo a .env.local y rellena lo que necesites.
# Sin las variables de Supabase la app arranca en MODO DEMO con datos de ejemplo.

# URL pública de la app (sin barra final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: webhooks, crons y panel de administración. No la expongas nunca.
SUPABASE_SERVICE_ROLE_KEY=

# Modelos de IA (redacción, estrategia y seguimiento de visibilidad)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# Stripe (suscripciones). Usa claves sk_test_ en desarrollo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (emails transaccionales). Sin clave los emails se registran en consola.
RESEND_API_KEY=
# Opcional: remitente verificado en Resend
# EMAIL_FROM="yeswecontent <hola@tudominio.com>"

# Protege /api/cron/*. Vercel lo envía como "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Google OAuth (Search Console y GA4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# En Google Cloud, Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/oauth/google/callback

# Meta (Facebook e Instagram). Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=

# Reddit (app de tipo "web app"). Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/oauth/reddit/callback
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="web:yeswecontent:1.0 (by /u/tu_usuario)"

# Firma del parámetro state de OAuth y de las URLs de las diapositivas. Genera uno con: openssl rand -base64 32
OAUTH_STATE_SECRET=
# Cifra (AES-256-GCM) los tokens OAuth y las credenciales de los CMS. 32 bytes en base64: openssl rand -base64 32
# No la cambies una vez en producción: no podrías descifrar las conexiones guardadas.
INTEGRATIONS_ENCRYPTION_KEY=

# Imágenes de artículos (opcional; sin clave se generan portadas propias)
OPENAI_IMAGE_MODEL=gpt-image-1

# Entrega headless (API de contenido, blog alojado, webhooks de frameworks)
HOSTED_BLOG_CNAME_TARGET=blogs.yeswecontent.com
HOSTED_BLOG_DOMAINS=
PLATFORM_HOSTS=
YWC_API_RATE_LIMIT=600
